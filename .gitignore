# Root .gitignore — complements khmer_sign_recognizer/.gitignore (which covers
# the project's data, models, venv, and Python caches in detail).

# Local Claude Code / agent settings and worktrees — machine-specific, not code.
.claude/

# Python virtual environments (any level, as a safety net)
venv/
venv_wsl/
.venv/
env/

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Logs & temp
*.log
*.tmp
*.bak

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Avatar models — tens of MB each, and each carries its own licence.
# The README and the hand-written .rig.json descriptions are tracked (small,
# and a rig worked out once should not have to be worked out again); the
# model files themselves are not.
khmer_sign_recognizer/assets/avatars/*
!khmer_sign_recognizer/assets/avatars/README.md
!khmer_sign_recognizer/assets/avatars/*.rig.json
