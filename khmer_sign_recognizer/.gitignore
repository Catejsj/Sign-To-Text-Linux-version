# ── Virtual environments ──
venv/
venv_wsl/
.venv/
env/

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# ── Logs & temp ──
*.log
logs/
*.tmp
*.bak

# ── Recorded training data (synced via Drive, not Git) ──
data/
*.npy
# Every language's labels.json IS tracked, so the whole team records against
# one vocabulary. Git cannot un-ignore a file inside an ignored directory, so
# a `!data/...` rule here would not work. Add a new language's file once by
# hand — after that it is tracked and this rule no longer applies to it:
#     git add -f data/sequences_v2/<lang>/labels.json

# ── Per-person export folders, built by scripts/export_recordings.py.
#    They are a copy of data/ shaped for upload — regenerable, and big. ──
exports/

# ── Archives. A zipped snapshot of a folder that is already tracked goes
#    stale the moment the folder changes; share a git ref instead. ──
*.zip

# ── Trained model weights (synced via Drive, not Git) ──
models/
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors

# ── Secrets ──
.env
.env.*
!.env.example

# ── Notebook checkpoints ──
.ipynb_checkpoints/

# ── OS junk ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──
.vscode/
.idea/
*.swp
*~

# ── rclone (should live in user profile, guard against accidents) ──
rclone.conf

# ── JSON metadata sidecar files (paired with .npy, synced via Drive) ──
*.json
!config/*.json
!**/labels.json

# ── Video/image captures ──
*.mp4
*.avi
*.mov
*.jpg
*.jpeg
*.png
!docs/**/*.png

# ── pytest / coverage ──
.pytest_cache/
.coverage
htmlcov/
